      "language": "vi",
      "stem": "Trong không gian $Oxyz$, mặt phẳng $(P): 2x - y + 3z - 5 = 0$ có một vectơ pháp tuyến là",
      "options": [
        {
          "id": "A",
          "text": "$\\vec{n} = (2; 1; 3)$"
        },
        {
          "id": "B",
          "text": "$\\vec{n} = (2; -1; -5)$"
