# Reverse proxy for the pilot (infra/docker-compose.prod.yml). Caddy gets and renews the Let's Encrypt certificate
# for $DOMAIN by itself (ports 80 and 443 must be reachable from the internet). A VM with only a public IP can use
# sslip.io: DOMAIN=203-0-113-5.sslip.io resolves to 203.0.113.5 with no DNS setup. DOMAIN=localhost (local smoke
# test) gets a certificate from Caddy's internal CA instead.
{
	admin localhost:2019
	servers {
		trusted_proxies static private_ranges
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Gateway: REST under /api (bearer-token auth). Everything else (including /healthz and /docs) is not routed to
	# the gateway.
	@gateway path /api/*
	handle @gateway {
		reverse_proxy gateway:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	log {
		output stdout
		# never log credentials: the bearer token travels in the Authorization header
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}
