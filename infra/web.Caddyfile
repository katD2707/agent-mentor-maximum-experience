# Static server inside the web image. The page and the service worker must never be cached, or an old build lingers.
{
	admin off
	auto_https off
}

:3000 {
	root * /srv
	encode zstd gzip
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
