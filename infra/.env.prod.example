# Pilot deployment settings. Copy to infra/.env.prod on the VM (deploy.sh does it for you), fill in, keep it
# private: `chmod 600 infra/.env.prod`. It is gitignored and excluded from every image. NEVER commit real values.
# Lines marked REQUIRED must be set; deploy.sh refuses to start without them. deploy.sh fills the ones marked
# AUTO with random values the first time.

# ---- Public address ---------------------------------------------------------------------------------------------
# REQUIRED. The host name learners open. Own domain: point an A record at the VM's public IP.
# Only a public IP? Use sslip.io: for IP 203.0.113.5 write 203-0-113-5.sslip.io (resolves to that IP, no DNS setup;
# Caddy still gets a real Let's Encrypt certificate).
DOMAIN=
# Leave empty: https://$DOMAIN. Only for a local test on another port, e.g. https://localhost:8443.
PUBLIC_URL=
# Leave at 80/443 on the VM (Let's Encrypt needs them).
HTTP_PORT=80
HTTPS_PORT=443
# Extra CORS origins, comma-separated (the Tauri app origins and http://localhost:5173 are always allowed).
CORS_ORIGINS=

# ---- Storage (host paths, absolute) ------------------------------------------------------------------------------
# Learner workspaces, mirrors and ops.db are plaintext on disk: put DATA_DIR on an encrypted disk if you can.
DATA_DIR=/srv/mentor/data
# Encrypted daily snapshots (MBK1). Copy them off the VM regularly (README: "Sao lưu").
BACKUP_DIR=/srv/mentor/backups

# ---- Keys --------------------------------------------------------------------------------------------------------
# REQUIRED, AUTO. Encrypts sensitive DB columns and every backup. Generate yourself with
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# or: openssl rand -base64 32 | tr '+/' '-_'
# LOSING IT = all backups and sealed fields are unreadable. Keep a copy outside the VM (password manager).
MENTOR_MASTER_KEY=
# REQUIRED, AUTO. Key for the LiteLLM router (any long random string, e.g. sk-<hex>).
MODEL_ROUTER_MASTER_KEY=

# ---- Model provider (FPT / omniroute) ---------------------------------------------------------------------------
# REQUIRED. OpenAI-compatible base URL and API key from FPT AI Factory. Only the model-router container sees them.
FPT_API_BASE=
FPT_API_KEY=

# ---- Web Push (nudges when the app is closed) ---------------------------------------------------------------------
# AUTO. deploy.sh generates the pair once (openssl) and never replaces it: a new public key silently ends pushes to
# every browser that subscribed with the old one. Any of the three empty = push off (in-app nudges still work).
# VAPID_SUBJECT: contact address for the push services, mailto:... or https://... (deploy.sh sets https://<DOMAIN>).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Rarely changed ----------------------------------------------------------------------------------------------
# Daily backup at this UTC hour (19 = 02:00 Vietnam).
BACKUP_HOUR_UTC=19
# Pin image versions for a long pilot, e.g. ghcr.io/berriai/litellm:<version>
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
CADDY_IMAGE=caddy:2-alpine
# Fixed name of the router container; change only for a second stack on one host.
ROUTER_CONTAINER_NAME=mentor-model-router
