# Pilot deployment settings. Copy to infra/.env.prod on the VM (deploy.sh does it for you), fill in, keep it
# private: `chmod 600 infra/.env.prod`. It is gitignored and excluded from every image. NEVER commit real values.
# Lines marked REQUIRED must be set; deploy.sh refuses to start without them. deploy.sh fills the ones marked
# AUTO with random values the first time.

# ---- Public address ---------------------------------------------------------------------------------------------
# REQUIRED. The host name learners open. Own domain: point an A record at the VM's public IP.
# Only a public IP? Use sslip.io: for IP 203.0.113.5 write 203-0-113-5.sslip.io (resolves to that IP, no DNS setup;
# Caddy still gets a real Let's Encrypt certificate).
DOMAIN=
# Leave empty: https://$DOMAIN. Only for a local test on another port, e.g. https://localhost:8443.
PUBLIC_URL=
# Optional. Link to Mentor-Setup-<version>.exe for the web app's setup guide (step "Cài app máy tính"); empty hides
# that step. Baked into the web build: rebuild the web image after changing it.
DESKTOP_DOWNLOAD_URL=
# Optional. Link to the Linux app (Mentor_<version>_amd64.deb or the .AppImage, apps/desktop/build-linux.sh), shown
# instead of the .exe to Linux desktop browsers. Empty = Linux users see DESKTOP_DOWNLOAD_URL. Rebuild the web image.
DESKTOP_DOWNLOAD_URL_LINUX=
# Leave at 80/443 on the VM (Let's Encrypt needs them).
HTTP_PORT=80
HTTPS_PORT=443
# Extra CORS/WebSocket origins, comma-separated. Empty is right: the desktop app loads https://$DOMAIN/popup
# (same origin as the web app).
CORS_ORIGINS=

# ---- Storage (host paths, absolute) ------------------------------------------------------------------------------
# Learner workspaces, mirrors and ops.db are plaintext on disk: put DATA_DIR on an encrypted disk if you can.
DATA_DIR=/srv/mentor/data
# Encrypted daily snapshots (MBK1). Copy them off the VM regularly (README: "Sao lưu").
BACKUP_DIR=/srv/mentor/backups
# Group id of /var/run/docker.sock. AUTO (deploy.sh: stat -c %g /var/run/docker.sock).
DOCKER_GID=

# ---- Keys --------------------------------------------------------------------------------------------------------
# REQUIRED, AUTO. Encrypts sensitive DB columns and every backup. Generate yourself with
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# or: openssl rand -base64 32 | tr '+/' '-_'
# LOSING IT = all backups and sealed fields are unreadable. Keep a copy outside the VM (password manager).
MENTOR_MASTER_KEY=
# REQUIRED, AUTO. Key the gateway and sandboxes use for the LiteLLM router (any long random string, e.g. sk-<hex>).
MODEL_ROUTER_MASTER_KEY=
# REQUIRED, AUTO. Secret SearXNG signs its cookies with.
SEARXNG_SECRET=

# ---- Model provider (FPT / omniroute) ---------------------------------------------------------------------------
# REQUIRED. OpenAI-compatible base URL and API key from FPT AI Factory. Only the model-router container sees them.
FPT_API_BASE=
FPT_API_KEY=

# ---- Who may log in ----------------------------------------------------------------------------------------------
# Comma-separated emails and/or @domains invited to the pilot, e.g. hs1@gmail.com, ncs.lan@gmail.com, @school.edu.vn
# Others get "chưa được mời". Leave empty only if anyone with the URL may sign up (and spend model quota).
SIGNUP_ALLOWLIST=

# ---- Login mail (Gmail SMTP) -------------------------------------------------------------------------------------
# REQUIRED. Magic links and 6-digit login codes. Gmail: turn on 2-Step Verification for the sending account, then
# https://myaccount.google.com/apppasswords -> create an app password (16 letters; spaces do not matter).
# Gmail limit: about 500 recipients/day for a free account (2000 for Workspace); more and logins stop for ~24 h.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# or port 465 with SMTP_SSL=true and SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender; must be the Gmail address itself (or an alias verified in Gmail), e.g. AI Mentor <mentor.pilot@gmail.com>
MAIL_FROM=

# ---- Parent channel (Zalo bot) -----------------------------------------------------------------------------------
# Needed for THPT learners: their account stays locked until a parent links on Zalo (no dev button in prod).
# Token from https://bot.zaloplatforms.com (create a bot). After the stack is up deploy.sh registers the webhook
# https://$DOMAIN/webhooks/zalo with Zalo.
ZALO_BOT_TOKEN=
# REQUIRED, AUTO. 8-256 characters; Zalo sends it back on every webhook call.
ZALO_WEBHOOK_SECRET=
# The bot's share link, copied from the bot's page on bot.zaloplatforms.com (shown as a QR on the onboarding page)
ZALO_BOT_URL=
ZALO_BOT_NAME=Mentor Phụ huynh

# ---- Learner email forwarding (Cloudflare Email Routing, optional) ------------------------------------------------
# Each learner gets <code>@INBOUND_EMAIL_DOMAIN (Cài đặt -> Email chuyển tiếp). Mail to it is received by Cloudflare
# Email Routing, handed to the Email Worker infra/cloudflare/email-worker.js, which POSTs it to
# https://$DOMAIN/webhooks/email/inbound. Setup: README.md "Chuyển tiếp email của học viên".
# A domain on Cloudflare DNS with Email Routing on, best one used only for this, e.g. mentor-inbox.vn: the catch-all
# rule that sends every <code>@ address to the Worker exists only for apex domains (a subdomain such as
# inbox.example.vn needs one literal rule per learner). Empty = addresses shown as <code>@inbox.mentor.local, which
# receive nothing.
INBOUND_EMAIL_DOMAIN=
# AUTO. Shared with the Worker (its secret EMAIL_WEBHOOK_SECRET); signs every forwarded message (HMAC-SHA256).
# Empty = the webhook answers 404. Changing it = update the Worker's secret too.
EMAIL_WEBHOOK_SECRET=
# Largest message accepted, bytes (26214400 = 25 MiB, Cloudflare's own limit). Larger mail bounces.
INBOUND_EMAIL_MAX_BYTES=26214400
# Per learner address; more in one hour gets a temporary failure (the sender's server retries later).
EMAIL_WEBHOOK_PER_RCPT_PER_HOUR=30

# ---- Literature and web tools (optional) -------------------------------------------------------------------------
# Ai2 Asta key (paper search/snippets for NCS); request at https://share.hsforms.com/1L4hUh20oT3mu8iXJQMV77w3ioxm
ASTA_API_KEY=
# Semantic Scholar key (optional fallback)
S2_API_KEY=
# web_search uses the bundled SearXNG by default. A Tavily key (tvly-...) wins over SearXNG when set.
SEARXNG_URL=http://searxng:8080
TAVILY_API_KEY=

# ---- Google Calendar for NCS (optional) --------------------------------------------------------------------------
# OAuth client of type "Web application" (infra/README.md "Google Calendar"). Authorized redirect URI to register:
#   https://<DOMAIN>/api/integrations/google-calendar/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Web Push (nudges when the app is closed) ---------------------------------------------------------------------
# AUTO. deploy.sh generates the pair once (openssl) and never replaces it: a new public key silently ends pushes to
# every browser that subscribed with the old one. Any of the three empty = push off (in-app nudges still work).
# VAPID_SUBJECT: contact address for the push services, mailto:... or https://... (deploy.sh sets https://<DOMAIN>).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Sandboxes ---------------------------------------------------------------------------------------------------
# Idle sandboxes are stopped after this many seconds (frees RAM and one docker network each).
SANDBOX_IDLE_SECONDS=600
# 1 = start a learner's sandbox when they open the chat (hides the ~3 s cold start); 0 on a very small VM.
SANDBOX_PREWARM=1
SANDBOX_TMPFS_SIZE=256m

# ---- Rarely changed ----------------------------------------------------------------------------------------------
# Daily backup at this UTC hour (19 = 02:00 Vietnam).
BACKUP_HOUR_UTC=19
# Pin image versions for a long pilot, e.g. ghcr.io/berriai/litellm:<version>
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
SEARXNG_IMAGE=searxng/searxng:latest
CADDY_IMAGE=caddy:2-alpine
SANDBOX_IMAGE=mentor-sandbox:prod
# Fixed name of the router container (sandboxes reach it by this name); change only for a second stack on one host.
ROUTER_CONTAINER_NAME=mentor-model-router
