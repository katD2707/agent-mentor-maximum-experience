# Local demo settings (bash infra/demo.sh copies this to infra/.env.demo the first time). Keep infra/.env.demo
# private; it is gitignored. Only the two FPT lines are required.

# REQUIRED. OpenAI-compatible base URL and API key from FPT AI Factory (the model gateway).
FPT_API_BASE=
FPT_API_KEY=

# Ports on this machine (http://localhost:WEB_PORT). Change if 3000/8000 are taken; changing API_PORT rebuilds the web.
WEB_PORT=3000
API_PORT=8000

# Generated by demo.sh on first run; leave empty.
MODEL_ROUTER_MASTER_KEY=
