# Try the web image on this machine: the page and /api on one address (http://localhost:3000), like the real deployment,
# with /api passed to the gateway running on the host (port 8000). Build the image with that address compiled in:
#   docker build -t mentor-web:local -f infra/web.Dockerfile --build-arg VITE_API_BASE=http://localhost:3000/api .
#   docker run -d --name mentor-web -p 3000:3000 -v "${PWD}/infra/web-local.Caddyfile:/etc/caddy/Caddyfile:ro" mentor-web:local
{
	admin off
	auto_https off
}

:3000 {
	handle /api/* {
		reverse_proxy host.docker.internal:8000 {
			flush_interval -1
		}
	}
	handle {
		root * /srv
		encode zstd gzip
		@fresh path / /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
