# Copy to .env.dev.local (same folder, gitignored) and fill in. Never put real values in this file: the repo is public.
# infra\dev-up.ps1 reads .env.dev.local; see README "Cài đặt và dùng thử".

# --- required: every model (text, photos, voice) goes through FPT AI Marketplace
FPT_API_BASE=
FPT_API_KEY=
# guards the local model router; leave empty and infra\dev-up.ps1 makes one up (sk-...) and saves it here
MODEL_ROUTER_MASTER_KEY=

# --- optional
# pictures for new lessons and a backup voice; without them lessons get drawn diagrams and the free voice
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# reminders while the browser is closed (web version only). Leave these out; this writes all three for you:
#   uv run python -m mentor_gateway.cli vapid-generate --env-file .env.dev.local --subject mailto:you@example.com
