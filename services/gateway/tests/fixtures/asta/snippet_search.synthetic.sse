data: {"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "{\"data\": [{\"snippet\": {\"text\": \"3.2.1 Scaled Dot-Product Attention We call our particular attention \\\"Scaled Dot-Product Attention\\\" (Figure 2). The input consists of queries and keys of dimension d k , and values of dimension d v . We compute the dot products of the query with all keys, divide each by \\u221a d k , and apply a softmax function to obtain the weights on the values.\", \"snippetKind\": \"body\", \"section\": \"Scaled Dot-Product Attention\", \"snippetOffset\": {\"start\": 9120, \"end\": 9530}}, \"score\": 0.61234, \"paper\": {\"corpusId\": \"13756489\", \"title\": \"Attention is All you Need\", \"authors\": [\"Ashish Vaswani\", \"Noam M. Shazeer\", \"Niki Parmar\", \"Jakob Uszkoreit\", \"Llion Jones\", \"Aidan N. Gomez\"], \"openAccessInfo\": {\"license\": \"\", \"status\": \"GREEN\", \"disclaimer\": \"Notice: ...\"}}}, {\"snippet\": {\"text\": \"\", \"snippetKind\": \"body\"}, \"score\": 0.1, \"paper\": {\"corpusId\": \"1\"}}], \"retrievalVersion\": \"pa1-v1\"}"}], "structuredContent": {"result": {"data": [{"snippet": {"text": "3.2.1 Scaled Dot-Product Attention We call our particular attention \"Scaled Dot-Product Attention\" (Figure 2). The input consists of queries and keys of dimension d k , and values of dimension d v . We compute the dot products of the query with all keys, divide each by \u221a d k , and apply a softmax function to obtain the weights on the values.", "snippetKind": "body", "section": "Scaled Dot-Product Attention", "snippetOffset": {"start": 9120, "end": 9530}}, "score": 0.61234, "paper": {"corpusId": "13756489", "title": "Attention is All you Need", "authors": ["Ashish Vaswani", "Noam M. Shazeer", "Niki Parmar", "Jakob Uszkoreit", "Llion Jones", "Aidan N. Gomez"], "openAccessInfo": {"license": "", "status": "GREEN", "disclaimer": "Notice: ..."}}}, {"snippet": {"text": "", "snippetKind": "body"}, "score": 0.1, "paper": {"corpusId": "1