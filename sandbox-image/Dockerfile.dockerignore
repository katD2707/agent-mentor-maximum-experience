# BuildKit uses this file for sandbox-image/Dockerfile (context = repo root).
# Only the three packages installed into the image are sent.
**
!packages/mentor-schemas/pyproject.toml
!packages/mentor-schemas/src/**
!sandbox-image/scripts/pyproject.toml
!sandbox-image/scripts/src/**
!sandbox-image/harness/pyproject.toml
!sandbox-image/harness/src/**
**/__pycache__
**/*.pyc
