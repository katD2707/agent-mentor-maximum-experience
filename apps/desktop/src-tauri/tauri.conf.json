{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mentor",
  "version": "0.1.0",
  "identifier": "vn.mentor.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": { "script": "node scripts/sync-mascot.mjs", "wait": true },
    "beforeBuildCommand": "node scripts/sync-mascot.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mentor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Mentor pop-up chat",
    "longDescription": "A floating Mentor bubble at the edge of the screen and a compact chat panel for the Mentor learning assistant.",
    "category": "Education",
    "linux": {
      "deb": {
        "section": "education"
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
